# Generated by Cargo
# will have compiled files and executables. The crates under `examples/` each
# declare their own `[workspace]`, so they build into a `target/` of their own
# rather than the root one -- hence `**`, a leading `/target/` would only match
# at the top level.
**/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Ignore rollup downloaded packages
node_modules

# Ignore yarn package manager lock
yarn.lock

# Ignore generated wasm and js
**/dist/js/

# Ignore vscode
.vscode
